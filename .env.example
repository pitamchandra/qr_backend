PORT=8000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/passport-verification
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Local API URL
API_URL=http://localhost:8000

# Frontend URL for QR codes (Netlify or local Vite)
FRONTEND_URL=http://localhost:5173

# Optional: extra allowed origins (comma-separated)
# CORS_ORIGIN=https://your-app.netlify.app

# Required on Vercel for passport photo / PDF uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
